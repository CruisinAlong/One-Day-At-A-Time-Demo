# ====================
# GameMaker Studio 2 / GameMaker (IDE 2023+)
# ====================

# Build output
/[Oo]utput/
*.win
*.zip
*.apk
*.aab
*.ipa
*.exe
*.yydebug

# Local temp/cache folders generated by the IDE
.import/
/tmp/

# GameMaker local-only project settings (per-machine)
*.yyp.lock
*/local_settings.json
.gms2_settings/

# Extension / platform local build caches
/android/
/ios/
/html5/
/windows/
/linux/
/macosx/

# User-specific options files (keep the shared .yyp, ignore local overrides)
*_user.yy
*.user

# ====================
# Visual Studio / VS Code (if used alongside GameMaker extension)
# ====================
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
bin/
obj/

# ====================
# OS-specific junk
# ====================
.DS_Store
Thumbs.db
desktop.ini

# ====================
# Editor backups / swap files
# ====================
*.bak
*.tmp
*~
